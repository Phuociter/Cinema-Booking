# Cổng chạy ứng dụng Frontend (khớp server.port trong vite.config.js)
VITE_PORT=3001

# Đường dẫn API Backend ASP.NET Core (khớp ASPNETCORE_HTTP_PORTS=5000 trong Backend/.env)
VITE_API_BASE_URL=http://localhost:5000/api

# Clerk Authentication (Chỉ dùng Publishable Key ở client, tuyệt đối không đưa Secret Key vào Frontend)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SECRET_KEY=