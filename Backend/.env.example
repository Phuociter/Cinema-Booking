# ==========================================
# 0. CLERK AUTHENTICATION (Backend Secret & Key)
# ==========================================
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ==========================================
# 1. SERVER & PORTS CONFIGURATION
# ==========================================
# Cổng & URL Backend (Dễ dàng tái sử dụng trong code và script)
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000/api
ASPNETCORE_HTTP_PORTS=5000
ASPNETCORE_ENVIRONMENT=Development

# Cổng & URL Frontend (Dùng cấu hình CORS và callback)
FRONTEND_PORT=3001
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000

# ==========================================
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cinema_db

# ==========================================
# 3. REDIS HOLD ENGINE (Dev C - Tuần 3)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOLD_TTL_SECONDS=300

# ==========================================
# 4. JWT AUTHENTICATION (Dev E)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long
JWT_ISSUER=MovieBookingAPI
JWT_AUDIENCE=MovieBookingClient
JWT_EXPIRE_MINUTES=1440

# ==========================================
# 5. PAYMENT GATEWAY SANDBOX (Dev E - Tuần 4)
# ==========================================
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3001/payment/callback
MOMO_NOTIFY_URL=http://localhost:5000/api/payments/callback
